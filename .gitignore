# El mapa de ProGuard traduce los nombres ofuscados a los originales. Es la
# pieza que deshace el ofuscado entero, asi que fuera del repo.
target/proguard_map.txt
target/proguard_seed.txt

# Maven incluido en la carpeta y su zip. Son 10 MB de binarios de terceros.
apache-maven-3.9.9/
maven.zip

# Carpetas de entrega. El JAR se sube a GitHub Releases, no al arbol de fuentes.
dist/
EasyPlayerReport.zip
EasyPlayerReport.jar

