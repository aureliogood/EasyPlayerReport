<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.easyplayerreport</groupId>
    <artifactId>EasyPlayerReport</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>EasyPlayerReport</name>
    <description>Reportes in-game con formulario nativo (Paper Dialog API) y menu de gestion para staff</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.11-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.3.0</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Solo para las pruebas. No entra en el JAR: las clases las copia el
            plugin, nunca los dependencias, y esto va en 'test'.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>EasyPlayerReport</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!--
                Las pruebas corren antes del empaquetado. Si una falla, el build
                para y no se genera un JAR con el codigo roto.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.7.0</version>
                <dependencies>
                    <!--
                        El plugin 2.7.0 sigue esperando net.proguard:proguard-base,
                        que ya no existe en Maven Central; ahora lo publica
                        Guardsquare como com.guardsquare:proguard-base.
                        Se queda en 7.4.x a proposito: desde la 7.5 proguard-base
                        arrastra proguard-core y las dos versiones se pisan entre si
                        al ejecutar el plugin. Con Java 21 como objetivo, la 7.4.2
                        sobra y va mas rapido.
                    -->
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>7.4.2</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                        <configuration>
                            <obfuscate>true</obfuscate>
                            <!--
                                Entra el jar que acaba de crear maven-jar-plugin (codigo
                                ya ofuscable + recursos) y sale target\EasyPlayerReport.jar
                                renombrado. Las tres dependencias son 'provided', asi que
                                maven-shade-plugin no las empaquetaba: aqui no se shadea nada.
                            -->
                            <injar>${project.build.finalName}.jar</injar>
                            <outjar>proguard-tmp/${project.build.finalName}.jar</outjar>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <addMavenDescriptor>false</addMavenDescriptor>
                            <options>
                                <!--
                                    '-include' y el nombre van como argumentos
                                    separados: ProGuard 7 no acepta '-include=ruta'.
                                    Ruta relativa a proposito, porque ProGuard parte
                                    los backslashes de Windows como si fueran
                                    opciones suyas.
                                -->
                                <option>-include</option>
                                <option>proguard.pro</option>
                                <!--
                                    El JDK no viene en el classpath de Maven, asi que
                                    sin esto ProGuard se queda sin java.lang.Object.
                                    Al venir como argumentos sueltos ProGuard no los
                                    parte por espacios, que es lo que pasaria si las
                                    rutas estuvieran escritas dentro del .pro.
                                    Solo hacen falta los modulos que usa el plugin:
                                    java.util.logging y java.sql. El resto arrives
                                    solo o no se usa.
                                -->
                                <option>-libraryjars</option>
                                <option>${java.home}/jmods/java.base.jmod</option>
                                <option>-libraryjars</option>
                                <option>${java.home}/jmods/java.logging.jmod</option>
                                <option>-libraryjars</option>
                                <option>${java.home}/jmods/java.sql.jmod</option>
                                <!-- java.net.http: lo usan el cliente de Discord y el
                                     verificador de actualizaciones. -->
                                <option>-libraryjars</option>
                                <option>${java.home}/jmods/java.net.http.jmod</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                El plugin de ProGuard deja el jar en target\proguard-tmp\ porque no
                puede escribir sobre el fichero que esta leyendo. Este paso lo mueve
                a target\EasyPlayerReport.jar, que es la ruta que espera build.bat.
                Se declara despues a proposito: en la misma fase se ejecutan en el
                orden en que aparecen.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-obfuscated-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/proguard-tmp</directory>
                                    <includes>
                                        <include>${project.build.finalName}.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>